#include <winver.h>
#include "version.h"

/* VERSIONINFO only. The application manifest is injected separately - see
 * build-msvc.bat (mt.exe post-link) and build-mingw.sh (windres). rc.exe's
 * resolution of relative file references inside a .rc is toolchain- and
 * CWD-dependent, so the manifest deliberately does not live here. */

VS_VERSION_INFO VERSIONINFO
FILEVERSION     NVCOLOR_VERSION_MAJOR,NVCOLOR_VERSION_MINOR,NVCOLOR_VERSION_PATCH,0
PRODUCTVERSION  NVCOLOR_VERSION_MAJOR,NVCOLOR_VERSION_MINOR,NVCOLOR_VERSION_PATCH,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "nvcolor contributors\0"
            VALUE "FileDescription",  "nvcolor - NVIDIA display colour controls\0"
            VALUE "FileVersion",      NVCOLOR_VERSION_STR "\0"
            VALUE "InternalName",     "nvcolor\0"
            VALUE "OriginalFilename", "nvcolor.exe\0"
            VALUE "ProductName",      "nvcolor\0"
            VALUE "ProductVersion",   NVCOLOR_VERSION_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
